# ── Telnyx ────────────────────────────────────────────────────────────────────
# Get these from: https://portal.telnyx.com → API Keys
TELNYX_API_KEY=KEY01234567_your_key_here
TELNYX_PUBLIC_KEY=your_ed25519_public_key_from_telnyx_portal
TELNYX_CONNECTION_ID=your_telnyx_connection_id
TELNYX_PHONE_NUMBER=+12025551234

# ── Database (Neon PostgreSQL) ─────────────────────────────────────────────────
# Get from: https://console.neon.tech → your project → Connection string
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# ── Upstash Redis ─────────────────────────────────────────────────────────────
# Get from: https://console.upstash.com → your database → REST API
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token
REDIS_URL=https://your-instance.upstash.io

# ── Pusher ────────────────────────────────────────────────────────────────────
# Get from: https://dashboard.pusher.com → your app → App Keys
PUSHER_APP_ID=your_pusher_app_id
PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret
PUSHER_CLUSTER=us2

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
# Must be at least 32 characters — used to secure API routes and Vercel cron
API_SECRET_KEY=change_this_to_a_random_32_plus_character_string

# ── Next.js ───────────────────────────────────────────────────────────────────
# Your deployed URL (use http://localhost:3000 for local dev)
NEXTAUTH_URL=http://localhost:3000