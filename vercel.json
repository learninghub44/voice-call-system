{
  "crons": [
    {
      "path": "/api/cron/scheduler?job=queue-processor",
      "schedule": "*/1 * * * *"
    },
    {
      "path": "/api/cron/scheduler?job=automation-rules",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/scheduler?job=campaign-runner",
      "schedule": "*/5 * * * *"
    }
  ],
  "functions": {
    "pages/api/webhooks/*.ts": {
      "maxDuration": 10
    },
    "pages/api/**/*.ts": {
      "maxDuration": 30
    },
    "pages/api/cron/scheduler.ts": {
      "maxDuration": 60
    }
  }
}